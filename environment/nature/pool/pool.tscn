[sub_resource type="Shader" id="PadSh"]
code = "shader_type canvas_item;
// lily pads bob gently on the water
void fragment() {
	vec2 cell = floor(UV / TEXTURE_PIXEL_SIZE / 12.0);
	float h = fract(sin(dot(cell, vec2(12.9898, 78.233))) * 43758.5453);
	vec2 uv = UV + vec2(round(sin(TIME * 0.9 + h * 6.28) * 0.7), round(sin(TIME * 0.7 + h * 9.0) * 0.5)) * TEXTURE_PIXEL_SIZE;
	COLOR = texture(TEXTURE, uv) * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="Pads"]
